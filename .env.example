# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://wardrobe:wardrobe@localhost:5433/wardrobe?schema=public"

# --- AI provider ----------------------------------------------------------
# "ollama" runs locally: free, private, no rate limits (see README for models).
# "anthropic" uses the hosted API and needs a funded key.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Only required when AI_PROVIDER=anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- App ------------------------------------------------------------------
# Single-user v1: every row is stamped with this id so auth can be added later
# without a data migration.
DEFAULT_USER_ID="local-user"

# Where uploaded garment photos live in dev (see src/lib/storage.ts).
UPLOAD_DIR="./uploads"

# Don't re-suggest a garment worn within this many days (basics are exempt).
WEAR_RECENCY_DAYS=7
